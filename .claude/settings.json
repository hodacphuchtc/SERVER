{
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Bash(find*)",
      "Bash(node *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(gitleaks *)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(supabase status*)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase db reset*)",
      "Bash(vercel ls*)",
      "Bash(vercel env ls*)",
      "Bash(wrangler r2 bucket list*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(*deploy*)",
      "Bash(npm publish*)",
      "Bash(gh repo create*)",
      "Bash(gh pr merge*)",
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(vercel env add*)",
      "Bash(vercel env rm*)",
      "Bash(wrangler r2 bucket create*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(secrets/**)",
      "Read(**/credentials*)",
      "Bash(*production*)",
      "Bash(git push --force*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Edit(package-lock.json)",
      "Write(package-lock.json)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Edit(**/yarn.lock)",
      "Write(**/yarn.lock)",
      "Edit(**/pnpm-lock.yaml)",
      "Write(**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p logs && date '+%Y-%m-%d %H:%M:%S' >> logs/claude-audit.log 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
