# Mẫu biến môi trường cho GIAM_SAT_SERVER — CHỈ tên biến, KHÔNG giá trị thật.
# Chép file này thành .env.local rồi điền giá trị. .env.local đã bị .gitignore chặn.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=          # Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Project Settings → API → anon public key
SUPABASE_SERVICE_ROLE_KEY=         # Project Settings → API → service_role (BÍ MẬT, chỉ dùng server)
DATABASE_URL=                      # Project Settings → Database → Connection string

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=                     # Cloudflare dashboard → R2 → Account ID
R2_ACCESS_KEY_ID=                  # R2 → Manage API Tokens
R2_SECRET_ACCESS_KEY=              # R2 → Manage API Tokens (BÍ MẬT)
R2_BUCKET_NAME=                    # tên bucket (ví dụ GIAM_SAT_SERVER-dev)

# --- Vercel (thường Vercel tự inject khi deploy; local dùng cho script) ---
# VERCEL_TOKEN=                    # chỉ đặt khi cần chạy vercel CLI trong script
