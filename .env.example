# Mẫu biến môi trường cho GIAM_SAT_SERVER — CHỈ tên biến, KHÔNG giá trị thật.
# Chép thành .env.local rồi điền. .env.local đã bị .gitignore chặn.
#
# Chưa điền gì vẫn chạy thử được: `npm run dev` dùng Postgres nhúng kèm dữ liệu mẫu.
# Các biến dưới đây chỉ cần khi đưa lên môi trường thật.

# ───────────────────────── Supabase (lưu số liệu) ─────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=          # https://<mã-dự-án>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # khoá anon public — dùng ở trình duyệt VÀ ở collector
#
# 🔴 KHÔNG khai SUPABASE_SERVICE_ROLE_KEY ở đây và TUYỆT ĐỐI không đưa nó cho collector.
# Collector chỉ cầm token riêng của đúng một máy (bảng hosts). Máy công ty bị xâm nhập thì
# kẻ tấn công chỉ ghi được số liệu của máy đó, không chạm được phần còn lại (BRD §7.2 ②).

# ───────────────────────── Cloudflare Worker (đồng hồ cảnh báo) ─────────────────────────
# Đặt bằng `wrangler secret put <TÊN>`, KHÔNG đặt trong wrangler.toml.
# Vì sao đồng hồ nằm ở cloud chứ không trong mạng công ty: mất điện văn phòng không được
# làm mất luôn khả năng biết mình đang mất điện (ADR-003).
RESEND_API_KEY=                    # resend.com → API Keys
EMAIL_NGUOI_GUI=                   # "Giám sát hệ thống <canh-bao@alerts.congty.vn>"
HOP_THU_QUAN_TRI=                  # it@congty.vn (nhiều địa chỉ ngăn bằng dấu phẩy)
HOP_THU_LANH_DAO=                  # ceo@congty.vn — CHỈ nhận khi nghiêm trọng quá 30 phút chưa ai xử lý
KHOA_KY_LINK=                      # chuỗi ngẫu nhiên ≥32 ký tự, ký link "Đã tiếp nhận" trong email

# ───────────────────────── Collector (chạy trong mạng nội bộ) ─────────────────────────
# File cấu hình riêng của collector, không phải biến của web. Mỗi máy MỘT token.
# Token sinh bằng: select public.xoay_token('máy chủ kế toán', '<token-mới>');
# COLLECTOR_TOKEN_MAY_CHU_KE_TOAN=
# COLLECTOR_TOKEN_MAY_CHU_BAN_HANG=

# ───────────────────────── Ghi chú về tên miền gửi mail ─────────────────────────
# Nên dùng subdomain riêng (alerts.congty.vn) để uy tín gửi thư tách khỏi email kinh doanh.
# Cấu hình SPF + DKIM + DMARC theo hướng dẫn của Resend; DMARC đặt p=none, theo dõi 2 tuần
# rồi mới nâng lên p=quarantine.
